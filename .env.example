# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública (anon / publishable). Es segura en el navegador porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL donde se sirve la app; se usa en los enlaces de los correos y de las invitaciones.
# En local: http://localhost:3000 · En Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
